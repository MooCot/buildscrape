{
  "title": "buildscrape pipeline",
  "uid": "buildscrape-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Items processed per second, by stage/status (Counter)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (stage, status) (rate(buildscrape_items_processed_total[1m]))",
          "legendFormat": "{{stage}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Queue length (Gauge) — main queues + DLQ",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "buildscrape_queue_length{queue=~\".*\\\\.queue|.*\\\\.dlq\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Stage duration p50/p95 (Histogram)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum by (stage, le) (rate(buildscrape_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{stage}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.50, sum by (stage, le) (rate(buildscrape_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{stage}}",
          "refId": "B"
        }
      ]
    }
  ]
}
